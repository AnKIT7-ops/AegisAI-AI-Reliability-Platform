        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Chat outcomes",
      "description": "Answered, refused before the model (low retrieval score) and refused by the model, per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "expr": "sum by (outcome) (rate(aegis_chat_answers_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
