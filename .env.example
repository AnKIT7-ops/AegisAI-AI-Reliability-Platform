# Copy to .env and replace the placeholders. Never commit .env.
POSTGRES_USER=aegis
# Use only letters and digits: the password is embedded in DATABASE_URL.
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aegis
FRONTEND_PORT=8080
# Address nginx publishes on. Anything but loopback needs the password hash and
# AEGIS_AUTH_COOKIE_SECURE=true, or the backend refuses to start.
# FRONTEND_BIND=127.0.0.1
# Grafana admin login (viewing needs none). Letters and digits.
GRAFANA_ADMIN_PASSWORD=changeme
# Optional sign-in. Generate the hash with:
#   docker compose run --rm --no-deps backend python -m app.core.auth
# AEGIS_AUTH_PASSWORD_HASH=
# AEGIS_AUTH_COOKIE_SECURE=false
# AEGIS_AUTH_SESSION_HOURS=8
# Optional. Where the backend container reaches Ollama (default shown).
# AEGIS_OLLAMA_URL=http://host.docker.internal:11434
# Monitoring drills only (docs/runbooks). Leave at 0.
# AEGIS_FAULT_DELAY_MS=0
# AEGIS_FAULT_ERROR_RATE=0
