# Copy to .env and replace the placeholders. Never commit .env.
POSTGRES_USER=aegis
# Use only letters and digits: the password is embedded in DATABASE_URL.
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aegis
BACKEND_PORT=8000
FRONTEND_PORT=8080
# Optional. Where the backend container reaches Ollama (default shown).
# AEGIS_OLLAMA_URL=http://host.docker.internal:11434
